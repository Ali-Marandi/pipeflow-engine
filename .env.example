# Local Docker Compose configuration. Generate unique values before production use.
MYSQL_DATABASE=pipeflow
MYSQL_USER=pipeflow
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-strong-root-password
PIPEFLOW_PORT=3000
REALTIME_SHARED_TOKEN=replace-with-a-long-random-websocket-token
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
REDIS_TELEMETRY_STREAM=pipeflow:telemetry:v1
REDIS_TELEMETRY_GROUP=pipeflow-realtime-v1
# Optional: require Authorization: Bearer <value> on GET /metrics.
METRICS_BEARER_TOKEN=replace-with-a-long-random-observability-token

# Bind any temporary shared WebSocket token to exactly one server-approved tenant.
# Keep the compatibility override false; it exists only for a time-boxed migration.
REALTIME_SHARED_TOKEN_TENANT_ID=
REALTIME_ALLOW_LEGACY_SHARED_TOKEN=false
